{
  "version": 1,
  "skip_dirs": [
    ".git",
    ".cursor",
    ".vs",
    "build",
    "_deps",
    "third_party",
    "vcpkg_installed",
    "out",
    "x64",
    "Win32",
    "Debug",
    "Release"
  ],
  "skip_prefixes": [
    "build-",
    "build_",
    "cmake-build"
  ],
  "skip_globs": [
    "*.pb.cc",
    "*.pb.h"
  ],
  "encoding": [
    {
      "glob": "*.c",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cc",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.h",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hh",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "any"
    },
    {
      "glob": "CMakeLists.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.cmake",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.in",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.ps1",
      "bom": true,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".clang-format",
      "bom": false,
      "eol": "any"
    },
    {
      "glob": ".clang-format-ignore",
      "bom": false,
      "eol": "any"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".editorconfig",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.c",
      "*.cc",
      "*.cpp",
      "*.cxx",
      "*.h",
      "*.hh",
      "*.hpp",
      "*.hxx"
    ],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [
    {
      "id": "cmake-libs",
      "globs": [
        "*.c",
        "*.cc",
        "*.cpp",
        "*.cxx",
        "*.h",
        "*.hh",
        "*.hpp",
        "*.hxx"
      ],
      "pattern": "#\\s*pragma\\s+comment\\s*\\(\\s*(lib|linker)",
      "message": "link Windows libraries through CMake target_link_libraries"
    }
  ],
  "headers": {
    "globs": [],
    "first_line": "#pragma once",
    "forbid_namespace_using": false
  },
  "versions": [],
  "changelog": null,
  "required_files": [
    "LICENSE",
    "README.md",
    "repo-rules.json",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".github/workflows/hygiene.yml",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    },
    "translations": {
      "pairs": [
        [
          "docs/zh/architecture.md",
          "docs/en/architecture.md"
        ],
        [
          "docs/zh/ci.md",
          "docs/en/ci.md"
        ],
        [
          "docs/zh/dev-plan.md",
          "docs/en/dev-plan.md"
        ],
        [
          "docs/zh/qt-widgets-inventory.md",
          "docs/en/qt-widgets-inventory.md"
        ]
      ],
      "marker": "translated-from:",
      "stale": "warning"
    }
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": []
  }
}
